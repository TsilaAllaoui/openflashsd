root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,ino}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{json,jsonc,yml,yaml}]
indent_style = space
indent_size = 4

[*.{sh,py,lua}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
