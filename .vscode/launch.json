{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GBA: Debug + Lua + GDB",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/gba/gba.elf",
      "cwd": "${workspaceFolder}/gba",
      "MIMode": "gdb",
      "miDebuggerPath": "/opt/devkitpro/devkitARM/bin/arm-none-eabi-gdb",
      "miDebuggerServerAddress": "127.0.0.1:2345",
      "preLaunchTask": "GBA: Prepare Debug Lua GDB",
      "stopAtEntry": false,
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}